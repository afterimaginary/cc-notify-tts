{
  "description": "Hands each event to the cc-notify-tts daemon, which decides whether to speak.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$HOME/Library/Application Support/cc-notify-tts/bin/python\"; [ -x \"$py\" ] || exit 0; exec \"$py\" -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/shim.py\" SessionStart",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$HOME/Library/Application Support/cc-notify-tts/bin/python\"; [ -x \"$py\" ] || exit 0; exec \"$py\" -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/shim.py\" SessionEnd",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$HOME/Library/Application Support/cc-notify-tts/bin/python\"; [ -x \"$py\" ] || exit 0; exec \"$py\" -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/shim.py\" UserPromptSubmit",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$HOME/Library/Application Support/cc-notify-tts/bin/python\"; [ -x \"$py\" ] || exit 0; exec \"$py\" -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/shim.py\" Stop",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$HOME/Library/Application Support/cc-notify-tts/bin/python\"; [ -x \"$py\" ] || exit 0; exec \"$py\" -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/shim.py\" StopFailure",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$HOME/Library/Application Support/cc-notify-tts/bin/python\"; [ -x \"$py\" ] || exit 0; exec \"$py\" -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/shim.py\" PermissionRequest",
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py=\"$HOME/Library/Application Support/cc-notify-tts/bin/python\"; [ -x \"$py\" ] || exit 0; exec \"$py\" -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/shim.py\" PermissionDenied",
            "async": true
          }
        ]
      }
    ]
  }
}
